+QString MainWindow::describeExternalWrite(const AdamDeviceServer *server,
+                                          QModbusDataUnit::RegisterType table,
+                                          int address,
+                                          const QList<quint16> &values)
+{
+    QStringList meanings;
+    for (qsizetype index = 0; index < values.size(); ++index) {
+        const int current = address + static_cast<int>(index);
+        const quint16 value = values.at(index);
+        if (server->profile().id == AdamDeviceId::Adam6256
+                && table == QModbusDataUnit::Coils) {
+            const QString name = ProcessSimulator::coilName(current);
+            if (name.isEmpty())
+                continue;
+            QString state = value ? QStringLiteral("ON") : QStringLiteral("OFF");
+            if (current == CorePoints::CoilEmergencyStop)
+                state = value ? tr("1=急停釋放") : tr("0=急停");
+            meanings.append(QStringLiteral("%1 %2").arg(name, state));
+        } else if (server->profile().id == AdamDeviceId::Adam6022
+                   && table == QModbusDataUnit::HoldingRegisters
+                   && current == CorePoints::HoldingPumpFrequency) {
+            meanings.append(tr("AO0 變頻器頻率 %1 Hz")
+                                    .arg(std::min<int>(value, 4095) * 60.0 / 4095.0, 0, 'f', 2));
+        } else if (server->profile().id == AdamDeviceId::Adam6224
+                   && table == QModbusDataUnit::HoldingRegisters
+                   && current >= 0 && current <= 3) {
+            meanings.append(tr("MV%1 開度 %2 %")
+                                    .arg(current + 1)
+                                    .arg(std::min<int>(value, 4095) * 100.0 / 4095.0, 0, 'f', 2));
+        }
+    }
+    return meanings.isEmpty()
+            ? QString()
+            : QStringLiteral("（%1）").arg(meanings.join(QStringLiteral("，")));
+}
