+namespace {
+QString stateName(int outcome)
+{
+    return outcome == Done ? QStringLiteral("done")
+         : outcome == Cancelled ? QStringLiteral("cancelled")
+                                : QStringLiteral("error");
+}
+constexpr int kMaxFinishedEntries = 30;
+} // namespace
