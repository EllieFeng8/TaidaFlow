+    wasmProxyOwner = std::make_unique<TaidaFlowProxy>();
+    Td = wasmProxyOwner.get();
+#else
+    Core& core = Core::instance();
+    core.init();
+    Td = core.m_proxy;
+    if (!Td) {
+        qCritical() << "TaidaFlowProxy is null.";
+        return EXIT_FAILURE;
+    }
+#endif
