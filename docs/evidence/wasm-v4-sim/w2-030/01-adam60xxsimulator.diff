+bool ProcessSimulator::emergencyStopInterlock() const
+{
+    return m_emergencyStopInterlock;
+}
+
+QString ProcessSimulator::digitalInputName(int channel)
+{
+    switch (channel) {
+    case CorePoints::DiPhaseOk: return tr("DI0 相位正常");
+    case CorePoints::DiLeakDetected: return tr("DI1 漏液檢出");
+    case CorePoints::DiMakeupPumpOverload: return tr("DI2 補水泵 OL");
+    case CorePoints::DiSpare: return tr("DI3 備用（Core 未使用）");
+    default: return tr("DI%1").arg(channel);
+    }
+}
+
+QString ProcessSimulator::coilName(int coil)
+{
+    switch (coil) {
+    case CorePoints::CoilVfdRun: return tr("DO0 變頻器啟動/循環泵");
+    case CorePoints::CoilInverterReset: return tr("DO1 變頻器復歸");
+    case CorePoints::CoilEmergencyStop: return tr("DO2 急停（active-low，0=急停）");
+    case CorePoints::CoilMakeupPump: return tr("DO3 補水泵");
+    case CorePoints::CoilBypassValve: return tr("DO4 二通閥/旁通閥");
+    default:
+        if (coil >= 16 && coil < 32)
+            return tr("DO%1（Core 未使用）").arg(coil - 16);
+        return {};
+    }
+}
+
+QString ProcessSimulator::pumpBlockReason() const
+{
+    if (!m_snapshot.pumpCommand)
+        return tr("DO0 未啟動");
+    if (!m_snapshot.phaseOk)
+        return tr("相位異常（DI0=0）");
+    if (m_emergencyStopInterlock && !m_snapshot.emergencyStopCoil)
+        return tr("急停迴路（DO2=0）");
+    return {};
+}
+
+QString ProcessSimulator::makeupPumpBlockReason() const
+{
+    if (!m_snapshot.makeupPumpCommand)
+        return tr("DO3 未啟動");
+    if (!m_snapshot.phaseOk)
+        return tr("相位異常（DI0=0）");
+    if (m_snapshot.makeupPumpOverload)
+        return tr("補水泵 OL 跳脫（DI2=1）");
+    if (m_emergencyStopInterlock && !m_snapshot.emergencyStopCoil)
+        return tr("急停迴路（DO2=0）");
+    return {};
+}
+
 void ProcessSimulator::setAutoEnabled(bool enabled)
 {
     m_autoEnabled = enabled;
     emit updated();
 }
 
+void ProcessSimulator::setEmergencyStopInterlock(bool enabled)
+{
+    if (m_emergencyStopInterlock == enabled)
+        return;
+    m_emergencyStopInterlock = enabled;
+    emit processEvent(enabled
+            ? tr("急停硬體連鎖已啟用：DO2=0 時循環泵與補水泵停止")
+            : tr("急停硬體連鎖已停用：DO2 僅顯示，不影響製程"));
+    updateRunStates();
+    emit updated();
+}
