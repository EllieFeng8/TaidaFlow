      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop-release",
      "displayName": "Build Desktop App",
      "configurePreset": "desktop-release",
      "targets": ["TaidaFlowApp"]
    },
    {
      "name": "wasm-debug",
      "displayName": "Build WASM Debug",
      "configurePreset": "wasm-debug",
      "inheritConfigureEnvironment": true,
      "targets": ["TaidaFlowApp"]
    },
    {
      "name": "wasm-release",
      "displayName": "Build WASM Release",
      "configurePreset": "wasm-release",
